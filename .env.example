# Copy to .env (gitignored). Never commit real camera credentials.
# Bind address. Keep 127.0.0.1 unless you have added authentication and HTTPS.
TABLEWATCH_HOST=127.0.0.1
TABLEWATCH_PORT=8000
# Optional: which detector weights to use (yolox_nano or yolox_tiny).
TABLEWATCH_MODEL=yolox_nano
# Example: an RTSP camera URL referenced by url_env in the Cameras page.
# TABLEWATCH_CAM_DINING_URL=rtsp://user:password@192.168.1.20:554/stream1
